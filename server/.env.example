# ============================================
# Supportly Server — Environment Configuration
# ============================================

# Database connection URL (PostgreSQL with SSL for Neon)
DATABASE_URL=postgresql://user:password@ep-sample-pool.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT Secret Key for signing Bearer authentication tokens (min 32 characters)
JWT_SECRET=supportly_super_secure_jwt_secret_production_key_32chars

# OpenRouter API Key for AI Assistant copilot
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Allowed Frontend URL for Cross-Origin Resource Sharing (CORS)
FRONTEND_URL=http://localhost:5173

# Server Port
PORT=3001
