# ============================================
# Supportly CRM — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgres://user:password@ep-xxx.us-east-1.aws.neon.tech/supportly?sslmode=require

# --- Authentication ---
# Generate a strong random string (min 32 chars)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-min-32-characters-here

# --- AI Feature (OpenRouter) ---
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- Frontend ---
VITE_API_URL=http://localhost:3001

# --- Backend ---
PORT=3001
FRONTEND_URL=http://localhost:5173
