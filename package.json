{
  "name": "supportly",
  "version": "1.1.2",
  "description": "Customer Support Ticketing CRM System",
  "private": true,
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "db:migrate": "cd server && npm run db:migrate",
    "db:seed": "cd server && npm run db:seed",
    "db:create-admin": "cd server && npm run db:create-admin",
    "install:all": "cd client && npm install && cd ../server && npm install"
  },
  "keywords": ["crm", "support", "ticketing", "customer-service"],
  "author": "",
  "license": "MIT"
}
